{
  "name": "acexperts-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:seo": "node --test scripts/seo-metadata.test.mjs",
    "test:forms": "node --test scripts/contact-security.test.mjs scripts/form-delivery.test.mjs scripts/zoho-contact-response.test.mjs",
    "check:routes": "node scripts/validate-redesign.mjs",
    "check:responsive": "node scripts/responsive-layout-check.mjs",
    "check:motion": "node scripts/motion-browser-check.mjs",
    "check:ac-viewer": "node scripts/ac-viewer-browser-check.mjs",
    "check:completion": "node scripts/completion-browser-check.mjs",
    "check:homepage": "node scripts/homepage-updates-browser-check.mjs",
    "test:security": "node --test scripts/contact-security.test.mjs scripts/content-security.test.mjs",
    "check:security": "node scripts/security-browser-check.mjs",
    "crawl": "node scripts/crawl.mjs",
    "migrate": "node scripts/migrate.mjs && node scripts/refresh-inventory.mjs",
    "validate": "node scripts/validate.mjs",
    "test:shared": "node --test scripts/shared-store.test.mjs"
  },
  "dependencies": {
    "html-react-parser": "^6.1.8",
    "next": "^16.3.8",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3"
  }
}

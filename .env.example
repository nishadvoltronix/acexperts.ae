# Server-only values. Copy to .env.local for local setup; use the hosting secret
# manager for deployment. Never prefix these with NEXT_PUBLIC_ or commit secrets.
# Complete setup and production prerequisites: docs/delivery-configuration.md
BREVO_API_KEY=

# Registered and verified Brevo sender; approved team inbox receiving enquiries.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Existing Brevo newsletter list and active double opt-in template IDs (integers).
BREVO_NEWSLETTER_LIST_ID=
BREVO_NEWSLETTER_DOI_TEMPLATE_ID=
# HTTPS destination after the recipient confirms using the template DOI link.
BREVO_NEWSLETTER_REDIRECT_URL=

# Optional exact additional HTTPS origins for staging, comma-separated.
# Do not use trailing slashes or wildcards. Production + matching localhost
# origins are built in. Example: https://staging.example.invalid
FORM_ALLOWED_ORIGINS=

# Durable shared state. Apply db/migrations/001-form-state.sql separately first.
# PostgreSQL URL without query/fragment. Remote connections require verified TLS.
FORM_DATABASE_URL=
# 32 random bytes as 64 hex characters; SAME secret/namespace on all instances.
# A namespace key fingerprint prevents accidental uncoordinated key rotation.
FORM_STATE_SECRET=
# Separate staging and production namespaces, lowercase letters/digits/_/- only.
FORM_STORE_NAMESPACE=

# Approved HTTPS privacy notice and immutable published version, linked by forms.
PRIVACY_NOTICE_URL=
PRIVACY_NOTICE_VERSION=
# Owner-approved 1..3650 days. No default policy is assumed; required for signup.
NEWSLETTER_CONSENT_RETENTION_DAYS=
